{
  "pack_version": 1,
  "fts_api_version": 1,
  "id": "org.fluentbit.observability",
  "version": "1.0.1",
  "title": "Observability basics",
  "description": "Local author Lua blocks for logs, metric families and spans, with real-runtime fixtures.",
  "blocks": [
    {
      "name": "redact_log",
      "signals": [
        "logs"
      ],
      "source": "blocks/redact_log.lua",
      "privacy": true,
      "parameters": {
        "keys": {
          "type": "strings",
          "default": [
            "password",
            "authorization",
            "api_key"
          ]
        },
        "replacement": {
          "type": "string",
          "default": "[REDACTED]"
        }
      }
    },
    {
      "name": "metric_allowlist",
      "signals": [
        "metrics"
      ],
      "source": "blocks/metric_allowlist.lua",
      "parameters": {
        "names": {
          "type": "strings",
          "required": true
        }
      }
    },
    {
      "name": "span_route_name",
      "signals": [
        "traces"
      ],
      "source": "blocks/span_route_name.lua",
      "parameters": {
        "route_attribute": {
          "type": "string",
          "default": "http.route"
        }
      }
    },
    {
      "name": "dedupe_log",
      "signals": [
        "logs"
      ],
      "source": "blocks/dedupe_log.lua",
      "parameters": {
        "keys": {
          "type": "selectors",
          "required": true
        },
        "ttl_ms": {
          "type": "number",
          "required": true
        }
      }
    }
  ],
  "fixtures": [
    "tests/redact-log.yaml",
    "tests/metric-allowlist.yaml",
    "tests/span-route-name.yaml",
    "tests/dedupe-log.yaml",
    "tests/otlp-privacy.yaml"
  ]
}
